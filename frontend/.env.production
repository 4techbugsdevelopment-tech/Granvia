# Production build config — Vite loads this automatically for `npm run build`
# (production mode) and it OVERRIDES matching keys in .env.
#
# Deployed frontend:  https://granvia.llc
# Deployed API:       https://aip.granvia.llc   (routes served under /api)
#
# The APK's WebView loads https://granvia.llc/app; the JS bundle below calls the
# API directly at the absolute URL — cross-origin, so the backend must allow the
# https://granvia.llc origin (set CORS_ORIGINS=https://granvia.llc on the API,
# or leave CORS_ORIGINS unset to reflect any origin).

VITE_API_URL=https://aip.granvia.llc/api

VITE_SITE_URL=https://granvia.llc
VITE_EMAIL_CONFIRMATION_REDIRECT_URL=https://granvia.llc/employer
VITE_EMPLOYER_LOGIN_REDIRECT_URL=https://granvia.llc/employer
