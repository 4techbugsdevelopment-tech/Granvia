# Backend origin/root. The frontend API client appends /api for absolute URLs
# because the Node backend mounts all routes there.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Dev only: where `npm run dev` forwards /api requests (your local backend root,
# NOT including /api). Node backend and Laravel both serve on :8000.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

VITE_SITE_URL=http://localhost:5174
VITE_EMAIL_CONFIRMATION_REDIRECT_URL=http://localhost:5174/employer
VITE_EMPLOYER_LOGIN_REDIRECT_URL=http://localhost:5174/employer
VITE_PRODUCTION_FRONTEND_URL=

VITE_PAYMENT_GATEWAY_PUBLIC_KEY=

# Google Maps JavaScript API key. Paste your purchased key in frontend/.env,
# enable Maps JavaScript API in Google Cloud, and restrict it by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAP_PROVIDER=google
