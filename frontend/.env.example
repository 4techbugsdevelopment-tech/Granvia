# Backend API base URL (Laravel). Set this in your build/deploy environment.
VITE_API_URL=http://127.0.0.1:8000/api

VITE_SITE_URL=http://localhost:5174
VITE_EMAIL_CONFIRMATION_REDIRECT_URL=http://localhost:5174/employer
VITE_EMPLOYER_LOGIN_REDIRECT_URL=http://localhost:5174/employer
VITE_PRODUCTION_FRONTEND_URL=

VITE_GOOGLE_MAPS_API_KEY=
VITE_PAYMENT_GATEWAY_PUBLIC_KEY=

# Map provider: 'leaflet' (default, no API key needed) | 'google' (requires VITE_GOOGLE_MAPS_API_KEY)
VITE_MAP_PROVIDER=leaflet
