# API base path. Leave as /api (relative) so the same build runs on localhost
# and production via the proxy (Vite dev proxy + host proxy). Only set this to a
# full URL (e.g. https://api.example.com/api) for a cross-origin backend + CORS.
VITE_API_URL=/api

# Dev only: where `npm run dev` forwards /api requests (your local backend root,
# NOT including /api). Node backend and Laravel both serve on :8000.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

VITE_SITE_URL=http://localhost:5174
VITE_EMAIL_CONFIRMATION_REDIRECT_URL=http://localhost:5174/employer
VITE_EMPLOYER_LOGIN_REDIRECT_URL=http://localhost:5174/employer
VITE_PRODUCTION_FRONTEND_URL=

VITE_GOOGLE_MAPS_API_KEY=
VITE_PAYMENT_GATEWAY_PUBLIC_KEY=

# Map provider: 'leaflet' (default, no API key needed) | 'google' (requires VITE_GOOGLE_MAPS_API_KEY)
VITE_MAP_PROVIDER=leaflet
