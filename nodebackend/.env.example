# ---------------------------------------------------------------------------
# Granvia Node backend — environment
# Copy this file to `.env` and fill in real values (never commit `.env`).
# ---------------------------------------------------------------------------

# Server
PORT=8000
# Externally reachable backend URL used for signed private file links.
# Granvia uses the live API domain strictly.
APP_URL=https://aip.granvia.llc
# Optional explicit override when reverse proxy headers are not forwarded.
# Granvia uses the live API domain strictly.
PUBLIC_API_URL=https://aip.granvia.llc
# Comma-separated list of allowed CORS origins (the React dev server, etc.)
CORS_ORIGINS=https://granvia.llc,https://www.granvia.llc,https://aip.granvia.llc

# SQL Server connection (Prisma `sqlserver` provider).
# Fill in the 5 <...> placeholders, keep everything else as-is:
#   <HOST>      = server host        e.g. your SQL Server hostname
#   <PORT>      = SQL Server port     e.g. 1433
#   <DATABASE>  = database name       e.g. granvia
#   <USER>      = SQL login user       e.g. sa
#   <PASSWORD>  = that login's password
# Named-instance alternative:
#   sqlserver://<HOST>\<INSTANCE>;database=<DATABASE>;user=<USER>;password=<PASSWORD>;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://<HOST>:<PORT>;database=<DATABASE>;user=<USER>;password=<PASSWORD>;encrypt=true;trustServerCertificate=true"

# Frontend URL used for email-verification redirects
FRONTEND_URL=https://granvia.llc

# Token lifetime in days (0 = never expires, matching Sanctum default)
TOKEN_EXPIRY_DAYS=0

# SMTP (optional). If unset, emails are skipped and OTP endpoints return dev_otp.
# The backend accepts either SMTP_* or Laravel-style MAIL_* variables.
# SMTP_* takes precedence when both are present.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@granvia.local
SMTP_FROM_NAME=Granvia

# Surepass DigiLocker sandbox. Keep the bearer token server-side only.
SUREPASS_BASE_URL=https://sandbox.surepass.app
SUREPASS_BEARER_TOKEN=
SUREPASS_TIMEOUT_MS=15000

# Associate Partner Agreement + eSign.
# Keep production disabled until the selected ESP's official adapter is
# implemented and its credentials/certificates are configured server-side.
ESIGN_PROVIDER=unconfigured
ESIGN_SANDBOX_MODE=false
ESIGN_AGREEMENT_VERSION=AP-2026-V1
ESIGN_TEMPLATE_VERSION=AP-TEMPLATE-2026-V1
ESIGN_CALLBACK_URL=https://aip.granvia.llc/api/esign/callback
ESIGN_RETURN_URL=https://granvia.llc/universal-app/associate?esign_return=1
# Comma-separated GuardDocument types that must have a verified upload.
ESIGN_REQUIRED_DOCUMENT_TYPES=id_proof,bank_proof

# MySQL source for the one-off data migration (scripts/migrate-data.ts).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=granvia
## Require fresh GPS coordinates for live attendance check-in/check-out.
## Safe default in code is true. Set false only for a controlled temporary bypass.
LOCATION_CAPTURE_ENABLED=true

# Browser-public Google Maps JavaScript API key. This is exposed through
# /api/config/public for the React app, so restrict it by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=

# SMS gateway (backend only). Keep registration OTP disabled until the migration,
# DLT mapping, sender/entity IDs, and provider credentials are configured.
SMS_ENABLED=false
SMS_PROVIDER=mock
SMS_REGISTRATION_OTP_ENABLED=false
SMS_MOCK_EXPOSE_OTP=false
SMS_OTP_HASH_SECRET=
SMS_OTP_TTL_SECONDS=300
SMS_OTP_GRANT_TTL_SECONDS=600
SMS_OTP_RESEND_COOLDOWN_SECONDS=60
SMS_OTP_MAX_ATTEMPTS=5
SMS_OTP_MAX_SENDS_PER_HOUR=5
SMS_OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20
SMS_OTP_MAX_VERIFY_REQUESTS_PER_IP_PER_15_MIN=30
SMS_TIMEOUT_MS=10000
SMS_MAX_RETRIES=2
SMS_RETRY_BASE_DELAY_MS=250

# PowerText. Confirm these values and the exact DLT-approved text in the portal.
POWERTEXT_BASE_URL=https://bulk.powerstext.in
POWERTEXT_SEND_PATH=
POWERTEXT_HTTP_METHOD=POST
POWERTEXT_AUTH_KEY=
POWERTEXT_SENDER_ID=
POWERTEXT_ROUTE_ID=
POWERTEXT_DLT_ENTITY_ID=
POWERTEXT_OTP_TEMPLATE_ID=
SMS_TEMPLATE_REGISTRATION_OTP=
