# ---------------------------------------------------------------------------
# Granvia Node backend — environment
# Copy this file to `.env` and fill in real values (never commit `.env`).
# ---------------------------------------------------------------------------

# Server
PORT=8000
# Comma-separated list of allowed CORS origins (the React dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# SQL Server connection (Prisma `sqlserver` provider).
# Fill in the 5 <...> placeholders, keep everything else as-is:
#   <HOST>      = server host        e.g. localhost   or   192.168.1.50
#   <PORT>      = SQL Server port     e.g. 1433
#   <DATABASE>  = database name       e.g. granvia
#   <USER>      = SQL login user       e.g. sa
#   <PASSWORD>  = that login's password
# Named-instance alternative:
#   sqlserver://<HOST>\<INSTANCE>;database=<DATABASE>;user=<USER>;password=<PASSWORD>;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://<HOST>:<PORT>;database=<DATABASE>;user=<USER>;password=<PASSWORD>;encrypt=true;trustServerCertificate=true"

# Frontend URL used for email-verification redirects
FRONTEND_URL=http://localhost:5173

# Token lifetime in days (0 = never expires, matching Sanctum default)
TOKEN_EXPIRY_DAYS=0

# SMTP (optional). If unset, emails are skipped and OTP endpoints return dev_otp.
# The backend accepts either SMTP_* or Laravel-style MAIL_* variables.
# SMTP_* takes precedence when both are present.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@granvia.local
SMTP_FROM_NAME=Granvia

# Surepass DigiLocker sandbox. Keep the bearer token server-side only.
SUREPASS_BASE_URL=https://sandbox.surepass.app
SUREPASS_BEARER_TOKEN=
SUREPASS_TIMEOUT_MS=15000

# Associate Partner Agreement + eSign.
# Keep production disabled until the selected ESP's official adapter is
# implemented and its credentials/certificates are configured server-side.
ESIGN_PROVIDER=unconfigured
ESIGN_SANDBOX_MODE=false
ESIGN_AGREEMENT_VERSION=AP-2026-V1
ESIGN_TEMPLATE_VERSION=AP-TEMPLATE-2026-V1
ESIGN_CALLBACK_URL=http://127.0.0.1:8000/api/esign/callback
ESIGN_RETURN_URL=http://localhost:5173/universal-app/associate?esign_return=1
# Comma-separated GuardDocument types that must have a verified upload.
ESIGN_REQUIRED_DOCUMENT_TYPES=id_proof,bank_proof

# MySQL source for the one-off data migration (scripts/migrate-data.ts).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=granvia
