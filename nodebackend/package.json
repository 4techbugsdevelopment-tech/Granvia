{
  "name": "granvia-nodebackend",
  "version": "0.1.0",
  "private": true,
  "description": "Granvia API — Node.js (Express + Prisma + SQL Server) backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test:esign": "tsx --test tests/esign.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "migrate:data": "tsx scripts/migrate-data.ts",
    "backfill:employers": "tsx scripts/backfill-legacy-employers.ts",
    "seed:demo-users": "tsx scripts/seed-demo-auth-users.ts"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mssql": "^12.7.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.6",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
