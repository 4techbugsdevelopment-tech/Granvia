{
  "expo": {
    "name": "Granvia Partner",
    "slug": "granvia-partner-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "granvia",
    "splash": {
      "backgroundColor": "#0f1e3c",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.granvia.partner",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0f1e3c"
      },
      "permissions": ["INTERNET", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "CAMERA"]
    },
    "extra": {
      "//": "The deployed universal-app URL the WebView loads. Override per build.",
      "appUrl": "https://granvia.llc/app",
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
