{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "granvia-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5199", "--strictPort"],
      "port": 5199
    },
    {
      "name": "granvia-api",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-S", "127.0.0.1:8000",
        "-t", "C:/reactprojects/granvia/backend/public",
        "C:/reactprojects/granvia/backend/public/index.php"
      ],
      "port": 8000
    }
  ]
}
